ENV=
BACKEND_URL=
FRONTEND_URL=

MONGO_URI=
MONGO_DB_NAME=

# NEW secrets - deliberately NOT shared with Quiz-App
JWT_SECRET=
JWT_ACCESS_TTL_MIN=
JWT_REFRESH_TTL_DAYS=
# Minutes of no requests before a session is ended server-side. Default 30.
SESSION_IDLE_TIMEOUT_MIN=
FIELD_ENCRYPTION_KEY=

# Shared with Quiz-App
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Reference intervals and critical limits for this deployment. Unset means the
# shipped illustrative values, which are a demonstration and not guidance.
# See reference-config.example.json. Invalid config refuses to boot on purpose.
# Total stored PDF bytes one account may hold. Default 200 MB.
MAX_ACCOUNT_BYTES=

REFERENCE_CONFIG_PATH=

LLM_CONFIDENCE_FLOOR=
LOG_LEVEL=
GEMINI_MODEL=
REDIS_URL=
ARQ_QUEUE_NAME=labledger:jobs

# EmailJS — server-side (strict) API, never the browser.
EMAILJS_SERVICE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_TEMPLATE_RESET=
EMAILJS_TEMPLATE_INVITE=
# Minutes a password-reset link stays valid. Short: it is a bearer token for
# the account sitting in a mailbox.
PASSWORD_RESET_TTL_MIN=30
